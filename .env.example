# Public site identity
NEXT_PUBLIC_SITE_URL=https://inception23.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Admin access. Use a generated password of at least 24 characters in production.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_ROLE=admin

# Runtime database. Docker uses file:/app/data/inception23.db by default.
DATABASE_URL=file:./dev.db

# Required before saving tracking secrets. Generate 32 random bytes as 64 hex characters.
# Keep stable across deployments and back it up separately from the database.
TRACKING_ENCRYPTION_KEY=
# Enable only behind a proxy that overwrites X-Forwarded-For with the visitor IP.
TRACKING_TRUST_PROXY=false

# Required for production CMS uploads.
BLOB_READ_WRITE_TOKEN=

# Optional AI provider. Leave disabled when unused.
AI_PROVIDER=disabled
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
LOCAL_AI_ENDPOINT=
